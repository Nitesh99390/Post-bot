# Required: token from @BotFather
BOT_TOKEN=123456789:replace_with_your_token

# Public HTTPS base URL. Used for the webhook and the Mini App (<url>/app/).
# Render provides RENDER_EXTERNAL_URL automatically.
# WEBHOOK_URL=https://your-app.onrender.com
# Optional: override the address Telegram opens for the Mini App.
# WEBAPP_URL=https://your-app.onrender.com/app/
PORT=10000

# Optional: Supabase storage (defaults to the linked project).
# Run supabase/migrations/20261106000000_mini_app.sql once in the SQL editor.
# SUPABASE_URL=https://tmziuejwimwzyowkvhak.supabase.co
# SUPABASE_KEY=sb_secret_or_publishable_key
# STORAGE=memory   # disable Supabase
